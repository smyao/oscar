+@pytest.mark.parametrize("bad_live", [False, True])
+def test_compaction_preserves_validated_context_and_live_error_row(monkeypatch, bad_live):
+    model, context, values, _, _ = _case(monkeypatch)
+    original = context.attn_metadata["mtp"]
+    lengths = original.seq_lens.clone()
+    if bad_live:
+        lengths[1] = 0  # Forward validator's fail-closed sentinel, never padding.
+    published = replace(original, seq_lens=lengths, explicit_draft_context=True)
+    context.attn_metadata = {"mtp": published}
+    def consume(model, **kwargs):
+        compacted = context.attn_metadata["mtp"]
+        assert compacted.explicit_draft_context
+        assert compacted.seq_lens.data_ptr() == published.seq_lens.data_ptr()
+        assert torch.equal(compacted.seq_lens, lengths)
+        assert compacted.slot_mapping[1] >= 0
+        assert compacted.num_actual_tokens == 2
+        return kwargs["hidden_states"]
+    compact._compact_call(consume, model, (), values, None, context, FLAGS, (1, 1, 4))
+    assert context.attn_metadata["mtp"] is published
