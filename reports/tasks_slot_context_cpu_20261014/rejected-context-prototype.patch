+
+
+def later_draft_context_copy(common, slots, *, draft_index):
+    """Validate native's forward cache mapping and publish an exact context.
+
+    Archive #157-159: native attn_update_stack_num_spec_norm writes
+    common.positions[:B] from the SAME clamped position used for the slot
+    gather. That published cache coordinate is authoritative for this later
+    step; optimistic seq_lens is not its upper bound (e.g. an mRoPE delta).
+    The caller qualifies ordinary eager MTP. All checks remain on device.
+    A malformed live row gets length zero, so unchanged prepare reports error
+    1 before any history read. It is never converted to padding. Only native
+    negative slots and the explicit native discard mask retain padding.
+    """
+    scope = _scope.get()
+    source = common.seq_lens
+    if scope is None or scope.dummy or draft_index == 0:
+        return source, False
+    proposer = scope.proposer
+    if getattr(proposer, "use_cuda_graph", False):
+        return source, False
+    limit = getattr(proposer, "max_model_len", None)
+    groups = getattr(proposer, "seq_lens_group", None)
+    if (type(limit) is not int or limit <= 0 or limit > torch.iinfo(torch.int32).max
+            or getattr(proposer, "kernel_block_size", None) != 128
+            or groups is None or not 0 < draft_index < len(groups)):
+        raise OscarReadinessError("native later MTP cache-position contract is unavailable")
+    size = scope.requests
+    native = groups[draft_index]
+    position = getattr(common, "positions", None)
+    starts = common.query_start_loc
+    table = common.block_table_tensor
+    if (not torch.is_tensor(position) or position.ndim != 1
+            or position.dtype not in (torch.int32, torch.int64)
+            or position.stride() != (1,) or position.numel() < size
+            or starts.ndim != 1 or starts.dtype != torch.int32 or starts.stride() != (1,)
+            or starts.numel() < size + 1 or table.ndim != 2 or table.dtype != torch.int32
+            or table.shape[0] < size or table.shape[1] <= 0
+            or table.stride() != (table.shape[1], 1)
+            or source.ndim != 1 or source.dtype != torch.int32 or source.stride() != (1,)
+            or source.numel() < size or source.data_ptr() != native.data_ptr()
+            or slots.ndim != 1 or slots.stride() != (1,) or slots.numel() < size
+            or slots.dtype not in (torch.int32, torch.int64)
+            or any(t.device != source.device for t in (position, starts, table, slots))):
+        raise OscarReadinessError("native later MTP cache-position tensors do not match the proposal")
+    copies = getattr(proposer, "_oscar_later_context_copies", None)
+    if copies is None:
+        copies = {}
+        proposer._oscar_later_context_copies = copies
+    entry = copies.get(draft_index)
+    if entry is None:
+        entry = (native, torch.empty_like(native))
+        copies[draft_index] = entry
+    original, destination = entry
+    if (original.data_ptr() != native.data_ptr() or original.shape != native.shape
+            or original.dtype != native.dtype or original.device != native.device):
+        raise OscarReadinessError("native MTP context allocation changed after OSCAR binding")
+    result = destination[:source.numel()]
+    result.copy_(source)
+    pos = position[:size].to(torch.int64)
+    column = torch.div(pos, 128, rounding_mode="floor")
+    # Invalid coordinates still enter a bounded gather; the explicit bounds
+    # remain in valid. Clamping addresses never validates malformed inputs.
+    block = table[:size].gather(1, column.clamp(0, table.shape[1] - 1).unsqueeze(1)).squeeze(1)
+    expected_slot = block.to(torch.int64) * 128 + torch.remainder(pos, 128)
+    valid = ((starts[1:size + 1] - starts[:size] == 1)
+             & (source[:size] > 0) & (pos >= 0) & (pos < limit)
+             & (column < table.shape[1]) & (block >= 0)
+             & (common.slot_mapping[:size].to(torch.int64) == expected_slot))
+    live = slots[:size] >= 0
+    lengths = torch.where(valid, pos + 1, 0).to(source.dtype)
+    result[:size].copy_(torch.where(live, lengths, source[:size]))
+    return result, True
